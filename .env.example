# API del Apps Script (obligatoria)
API_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec

# --- Importación con IA (OpenCode Go) ---
# Estos valores son la SEMILLA inicial: la app los usa si nunca guardaste una
# configuración. Desde Ajustes → Importación con IA puedes cambiar el
# proveedor y la lista de modelos sin recompilar (se guarda en el dispositivo).
#
# Sin AI_API_KEY ni configuración en la app, la función de IA no se muestra.
# Crea una key en https://opencode.ai/console → Account → Personal API keys.
AI_API_KEY=

# Base URL del plan Go. Para pay-as-you-go usar:
# https://opencode.ai/inference/openai/v1
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Modelos por defecto, separados por comas (el primero es el principal).
# Ej.: AI_MODEL=deepseek-v4.1-flash,glm-5.3-flash
# Alternativas: glm-5.3-flash, gemini-4-argon (visión), gpt-6-luna.
# Es la SEMILLA: en la app puedes agregar más modelos y reordenarlos; si el
# principal se queda sin cuota o no está disponible, se prueba el siguiente.
AI_MODEL=deepseek-v4.1-flash
