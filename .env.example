# API del Apps Script (obligatoria)
API_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec

# --- Importación con IA (OpenCode Go) ---
# Sin AI_API_KEY la funcionalidad de IA no se muestra en la app.
# Crea una key en https://opencode.ai/console → Account → Personal API keys.
AI_API_KEY=

# Base URL del plan Go. Para pay-as-you-go usar:
# https://opencode.ai/inference/openai/v1
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Modelo por defecto (DeepSeek V4.1 Flash).
# Alternativas: glm-5.3-flash, gemini-4-argon (visión), gpt-6-luna.
AI_MODEL=deepseek-v4.1-flash
